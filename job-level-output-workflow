name: job-level-output-workflow
on:
  push: 
jobs:
  build:
    outputs:
      version: ${{ steps.step1.outputs.version }}
    runs-on: ubuntu-22.04
    steps:
     - name: step1
       id: step1
       run: echo "version=0.1" >> $GITHUB_OUTPUT
  deploy:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: takibg the value from job 1
        run: echo "deploy the version is ${{ needs.build.outputs.version}}"
        
      
